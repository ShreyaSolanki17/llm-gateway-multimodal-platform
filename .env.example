APP_NAME=LLM Gateway & Multimodal Platform
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# vLLM Model Serving Configuration
VLLM_SERVER_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
VLLM_TIMEOUT=30.0
VLLM_ENABLED=true
VLLM_SIMULATE_LOCAL=true

# OpenAI Configuration
OPENAI_API_KEY=

# Semantic Cache Configuration
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95

# RAG Pipeline Configuration
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.3

# PostgreSQL MCP Server Configuration (SQLite-backed for now)
MCP_DB_PATH=./data/mcp_gateway.db
MCP_QUERY_ROW_LIMIT=100

# Security & Guardrails Configuration
GATEWAY_API_KEY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_MESSAGES_PER_REQUEST=50
MAX_TOTAL_CONTENT_CHARS=50000
MAX_DOCUMENT_CHARS=200000
